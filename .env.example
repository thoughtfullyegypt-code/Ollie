# Development only. Copy to .env.local; never commit that file.
APP_MODE=development
ENABLE_DEV_TOOLS=true
# Cloud development data stays OUTSIDE checkout to avoid Next.js watcher reloads.
# Adjust this absolute directory for your local machine.
DEV_DATA_DIR=/workspace/.seat-at-internet-data
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Local development PostgreSQL started by npm run db:start.
DATABASE_URL=postgresql://seat:seat@127.0.0.1:54329/seat
# Generate securely: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Development admin uses the magic-link inbox. Explicitly replace in production.
ADMIN_EMAILS=admin@example.test
NEXT_PUBLIC_BRAND_NAME=A Seat at the Internet
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configure these only through your deployment secret manager.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Proposed service terms. Adopt final policies before enabling payments.
SERVICE_COMMITMENT_MONTHS=12
REFUND_WINDOW_DAYS=14
# Keep disabled until every launch check is independently verified.
LIVE_PAYMENTS_ENABLED=false
POLICIES_VERIFIED=false
PRICING_VERIFIED=false
TAXES_VERIFIED=false
# unconfigured keeps production checkout disabled. Use inclusive or
# not_applicable only after the operator verifies the applicable tax treatment.
TAX_POLICY=unconfigured
# Inclusive tax basis points, e.g. 500 means 5%; prices remain the exact total.
SALES_TAX_BPS=0
# Inclusive production checkout requires an active Stripe inclusive tax rate
# whose percentage matches SALES_TAX_BPS. Leave blank for local development.
STRIPE_TAX_RATE_ID=
LAUNCH_VERIFIED=false
# Trust only a reverse proxy which overwrites X-Real-IP and blocks direct origin access.
# Until BOTH flags are true, auth/reaction limits use a safe shared bucket.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_VERIFIED=false

# Production: APP_MODE=production, ENABLE_DEV_TOOLS=false,
# HTTPS APP_URL/BETTER_AUTH_URL/NEXT_PUBLIC_SITE_URL, managed DATABASE_URL,
# strong BETTER_AUTH_SECRET, verified email sender, monitored SUPPORT_EMAIL,
# explicit ADMIN_EMAILS, signed Stripe webhooks, adopted policies.
# Never put secret values in NEXT_PUBLIC_* variables.

# Production browser analytics are off unless both operator flags are enabled
# and the visitor explicitly opts in. Development uses the local event adapter.
ANALYTICS_ENABLED=false
ANALYTICS_PRIVACY_APPROVED=false
